# Backend (Node/Express)
BACKEND_PORT=8080
NODE_ENV=development

# Supabase — Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# anon (eyJ...) OU a nova publishable key (sb_publishable_...)
SUPABASE_ANON_KEY=sb_publishable_...
# service_role (eyJ...) OU a nova secret key (sb_secret_...). Só o ACESSO DO
# CLIENTE (portal + convites por e-mail) precisa dela; o resto do sistema
# funciona sem: auth via JWKS, CRUD no contexto do usuário (RLS).
SUPABASE_SERVICE_ROLE_KEY=
# OPCIONAL — só se o projeto ainda assinar tokens com HS256 (projetos novos
# usam ES256/JWKS, e o backend valida por lá automaticamente). Settings > API.
SUPABASE_JWT_SECRET=
# Conexão direta do Postgres — só o script de migrations usa.
# Settings > Database > Connection string > URI
SUPABASE_DB_URL=

# Parser (serviço Python)
PARSER_URL=http://localhost:8100
PARSER_SHARED_SECRET=troque-por-uma-string-aleatoria-longa

# CORS — origem do frontend
FRONTEND_ORIGIN=http://localhost:5173

# Tela PUBLICADA — o link do convite/nova senha que o cliente recebe leva pra
# cá (nunca pro localhost). Sem isso, usa o 1º FRONTEND_ORIGIN.
APP_URL=https://facility-contabil-mastro.onrender.com
